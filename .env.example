# ---------- General ----------
APP_NAME=I2C
APP_MODE=development            # development | production
SECRET_KEY=change-me-in-production
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ---------- Database ----------
DATABASE_URL=postgresql+psycopg2://i2c:i2c@postgres:5432/i2c
# Local dev without docker:
# DATABASE_URL=sqlite:///./i2c.db

# ---------- Storage ----------
STORAGE_PROVIDER=local          # local | s3
MEDIA_ROOT=./media
MEDIA_URL=/media
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# ---------- Feature flags ----------
AI_RECOGNITION_ENABLED=true
AI_DESCRIPTIONS_ENABLED=true
BACKGROUND_REMOVAL_ENABLED=true
VIRTUAL_MODEL_ENABLED=false
VIDEO_ENABLED=false
NINEROUTER_ENABLED=false
MOCK_PROVIDERS_ENABLED=true     # forced false when APP_MODE=production

